# demo-app の設定。これを demo-app/.env に写して、CLIENT_SECRET を入れる（.env は git に入らない）
# auth の origin。手元の auth（npm run dev）なら http://localhost:3000、本番なら https://auth.alphajinsei.com
ISSUER=http://localhost:3000
CLIENT_ID=demo-app
# auth で `admin create-client demo-app http://localhost:4000/callback` を実行したときに、一度だけ表示されたもの
CLIENT_SECRET=
ORIGIN=http://localhost:4000
PORT=4000
